# Public values are embedded in the browser bundle at build time.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_replace_me

# The same origin must be used for Clerk callbacks and API origin checks.
APP_URL=https://your-web-service.example.com
CLERK_SECRET_KEY=sk_live_replace_me
CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-frontend-api.example.com

# Set this in the web, worker, gateway, and Convex production deployment.
AHQ_SERVICE_SECRET=replace_with_a_long_random_value
CREDENTIAL_ENCRYPTION_KEY=replace_with_base64_for_32_random_bytes

# Server-side Convex clients may use this override. Leave empty to use
# NEXT_PUBLIC_CONVEX_URL.
CONVEX_URL=

# OpenAI is used by the worker. Keep this value out of the browser build.
OPENAI_API_KEY=sk-proj_replace_me
MCP_GATEWAY_URL=https://your-gateway-service.example.com

# S3-compatible archive storage is required when a worker archives files.
S3_ENDPOINT=https://your-s3-compatible-endpoint.example.com
S3_REGION=auto
# Most new Railway buckets use virtual hosted URLs. Check the bucket Credentials tab.
S3_FORCE_PATH_STYLE=false
S3_BUCKET=astra-hq-artifacts
S3_ACCESS_KEY_ID=replace_me
S3_SECRET_ACCESS_KEY=replace_me

# Convex only. Each URL must match the provider registry exactly. This is the
# admission allowlist used when an integration is saved.
MCP_SERVER_URLS_JSON={"linear":["https://mcp.linear.app/mcp"],"slack":["https://mcp.slack.com/mcp"],"github":["https://api.githubcopilot.com/mcp/"],"google-workspace":["https://gmailmcp.googleapis.com/mcp/v1","https://drivemcp.googleapis.com/mcp/v1","https://docsmcp.googleapis.com/mcp/v1","https://sheetsmcp.googleapis.com/mcp/v1","https://slidesmcp.googleapis.com/mcp/v1","https://calendarmcp.googleapis.com/mcp/v1"],"salesforce":["https://api.salesforce.com/platform/mcp/v1/platform/sobject-all"],"canva":["https://mcp.canva.com/mcp"],"servicenow":[]}

# Convex only. Each provider's list is the tool registry an administrator
# permits in employee marketplace capabilities. Keep it to tools that were
# discovered and reviewed at the exact URLs above.
MCP_TOOL_REGISTRY_JSON={"linear":[],"slack":[],"github":[],"google-workspace":[],"salesforce":[],"servicenow":[],"canva":[]}

# Web only. Map each connected Convex connection ID to a random relay secret.
INBOX_WEBHOOK_SECRETS_JSON={"connection_id":"replace_with_a_random_value"}

# Web, worker, and gateway admission controls. Values are hostnames for the first key
# and JSON objects for the latter two.
MCP_APPROVED_HOSTS=
MCP_TOOL_POLICIES_JSON={}
MCP_OAUTH_CONFIG_JSON={}

# Worker concurrency, then optional Convex budget tuning.
WORKER_CONCURRENCY=4
TASK_RESERVED_COST_USD=
TASK_RESERVED_COST_USD_LUNA=
TASK_RESERVED_COST_USD_TERRA=
TASK_RESERVED_COST_USD_SOL=
TASK_RESERVED_COST_USD_ASTRA=

# Railway supplies PORT. Do not hard-code it in a service variable.

# Convex platform administrators, and the worker turn deadline.
PLATFORM_ADMIN_USER_IDS=
MAX_TURN_SECONDS=900

# Web only: native inbox delivery. Use exact Slack channel IDs, GitHub repository IDs,
# or Linear team IDs. See docs/inbox-delivery.md. No subscriptions are created automatically.
NATIVE_INBOX_CONFIG_JSON={}
