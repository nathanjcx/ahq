# Public values are embedded in the browser bundle at build time.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_replace_me

# Web only. The same origin is used for request origin checks, the OAuth
# callback, and the relay URL shown for a connection.
APP_URL=https://your-web-service.example.com
CLERK_SECRET_KEY=sk_live_replace_me

# Convex only. Clerk's Frontend API URL, the issuer Convex validates.
CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-frontend-api.example.com

# Web, worker, gateway, and the Convex deployment. Authenticates service calls.
AHQ_SERVICE_SECRET=replace_with_a_long_random_value

# Web, worker, and gateway. 32 random bytes, base64. Seals every stored secret:
# provider credentials, OAuth client secrets, inbox secrets, relay secrets, and
# audit evidence. Convex never holds it.
CREDENTIAL_ENCRYPTION_KEY=replace_with_base64_for_32_random_bytes

# Optional server-side Convex URL override. Empty means NEXT_PUBLIC_CONVEX_URL.
CONVEX_URL=

# Worker only.
OPENAI_API_KEY=sk-proj_replace_me
# The gateway origin the hosted Agents session connects back to.
MCP_GATEWAY_URL=https://your-gateway-service.example.com

# Web and worker. The worker writes archived files; the web service reads them.
S3_ENDPOINT=https://your-s3-compatible-endpoint.example.com
S3_BUCKET=astra-hq-artifacts
S3_ACCESS_KEY_ID=replace_me
S3_SECRET_ACCESS_KEY=replace_me
# Optional. Defaults: auto, and false. Check the bucket's documented URL style.
S3_REGION=auto
S3_FORCE_PATH_STYLE=false

# Web and the Convex deployment. Comma-separated Clerk user IDs allowed to open
# the Operations page and edit provider configuration and the tool registry.
PLATFORM_ADMIN_USER_IDS=

# Worker tunables. Defaults 4 (1-16), 16 (1-64), and 900 seconds (60-3600).
WORKER_CONCURRENCY=4
WORKER_MONITORS=16
MAX_TURN_SECONDS=900

# Railway supplies PORT. Do not set it as a service variable.

# Everything provider-related is configured in the app, on the Operations page:
# enabled server URLs, OAuth clients, native inbox secrets, and the tool
# registry. See docs/deployment.md.
