FROM node:22.23-bookworm-slim AS runtime-deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

# The worker runs its TypeScript entry point through tsx; it serves no pages, so this image skips
# `next build` and carries only the source the process imports.
FROM node:22.23-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json tsconfig.json ./
COPY --from=runtime-deps /app/node_modules ./node_modules
COPY convex ./convex
COPY lib ./lib
COPY services ./services
USER node
# The process itself, so Railway's SIGTERM reaches the signal handlers in services/worker rather than a
# shell and npm. The worker reads PORT from the environment.
CMD ["node_modules/.bin/tsx", "services/worker.ts"]
