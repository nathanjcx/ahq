{
  "name": "astra-hq",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port ${PORT:-3000}",
    "worker": "tsx --env-file-if-exists=.env.local services/worker.ts",
    "gateway": "tsx --env-file-if-exists=.env.local services/gateway.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "format": "prettier --write app components lib convex services web-tests docs *.json *.ts",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@clerk/nextjs": "7.9.2",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "convex": "1.45.0",
    "fflate": "^0.8.2",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.44.0",
    "next": "16.3.5",
    "openai": "7.15.0",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.186.0",
    "tsx": "^4.23.13",
    "undici": "^7.29.1",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.185.4",
    "convex-test": "^0.0.41",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
